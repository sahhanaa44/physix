# Backend configuration
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/physix?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=5000
NODE_ENV=development
# Comma-separated frontend origins. Leave blank for local development only.
CLIENT_ORIGIN=http://localhost:5173
# Optional Google OAuth client ID
GOOGLE_CLIENT_ID=

# Frontend build-time variable. For separate hosting, point to the deployed API origin.
VITE_API_URL=
